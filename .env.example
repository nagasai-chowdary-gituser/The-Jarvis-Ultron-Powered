# ── Copy to .env and fill in. .env is gitignored and must never be committed. ──

# OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio (Phase 4) ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_NUMBER=+15551234567

# The ONLY caller allowed through. E.164 format. Cheap filter, not the real
# credential — the spoken PIN is (see AGENTS.md "Security boundary").
MY_NUMBER=+919999999999

# Public hostname of the cloudflared named tunnel, no scheme. (Phase 4)
PUBLIC_HOST=jarvis.example.com

# Security ───────────────────────────────────────────────────────────────────
# 4-6 digits. THIS IS A REAL CREDENTIAL — on a phone call it unlocks everything
# this machine can do, including running code. Caller ID is the only other gate
# and caller ID is spoofable.
#
# Defaults and obvious sequences (0000, 1234, 1111, 123456 ...) are REFUSED on a
# call rather than accepted with a warning, so leaving this as shipped means
# calls can look things up and nothing else. Pick digits nobody would guess.
#
# On a call, tap it on the keypad when Jarvis asks. The keypad beats speaking it:
# narrowband phone audio mishears digits, and anyone near you hears them.
JARVIS_PIN=0000

# Voice ──────────────────────────────────────────────────────────────────────
# Realtime voices: alloy, ash, ballad, coral, echo, sage, shimmer, verse,
# marin, cedar. "ash" is the level, formal male one. NOTE: onyx is a TTS-only
# voice and realtime REJECTS it.
JARVIS_VOICE=ash

# Spoken once when Jarvis starts, and at the start of every phone call.
JARVIS_GREETING=Welcome back, Boss. What do you want me to do?

# The one writable directory for recipe code. Absolute path.
WORKSPACE=C:\path\to\ultron\workspace

# Cost ───────────────────────────────────────────────────────────────────────
# Past this, every non-read-only action is refused. (Phase 6)
# Measured use is ~$0.18/day (AGENTS.md 9.1). $1.00 is ~5x headroom.
DAILY_CAP_USD=1.00

# Telegram (Phase 5) ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── WhatsApp bridge ───────────────────────────────────────────────────────────
# The local whatsmeow bridge (bridge/whatsapp-bridge.exe). Loopback only.
# PAIR A SECOND NUMBER, NOT YOUR MAIN ONE - see the ban-risk note at the top of
# lib/whatsapp.py. Start it, open http://127.0.0.1:8082/ and scan the QR.
WHATSAPP_BRIDGE=http://127.0.0.1:8082

# ── WhatsApp Desktop ──────────────────────────────────────────────────────────
# Jarvis drives YOUR already-signed-in WhatsApp Desktop app over the Chrome
# DevTools Protocol (it is a WebView2 inside a native shell). Nothing to pair.
# Only set these if the app moved or the port clashes.
WHATSAPP_CDP_PORT=9223
# WHATSAPP_APP_DIR=C:\Program Files\WindowsApps\5319275A.WhatsAppDesktop_..._x64__cv1g1gvanyjgm
